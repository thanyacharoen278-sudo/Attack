local uiOpen = true
local function setOpen(v)
    uiOpen = v
    Panel.Visible = v
    Logo.TextTransparency = v and 0 or 0.25
    logoStroke.Color = v and Color3.fromRGB(60, 140, 255) or Color3.fromRGB(90, 90, 90)
end

CloseBtn.MouseButton1Click:Connect(function()
    setOpen(false)
end)

local function makeDraggable(btn, target)
    local drag, block = false, false
    local d0, p0
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            drag, block = true, false
            d0 = input.Position
            p0 = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    drag = false
                    task.delay(0.1, function() block = false end)
                end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not drag then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - d0
            if d.Magnitude > 6 then block = true end
            target.Position = UDim2.new(p0.X.Scale, p0.X.Offset + d.X, p0.Y.Scale, p0.Y.Offset + d.Y)
        end
    end)
    return function() return block end
end

