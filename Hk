-------------------------------------------------
-- ATTACK
-------------------------------------------------
local function getRoot(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function ForceKill(humanoid, mob)
    if not humanoid then return end
    pcall(function()
        humanoid.Health = 0
        humanoid:ChangeState(Enum.HumanoidStateType.Dead)
        humanoid:TakeDamage(math.huge)
    end)
    -- บางเกมต้องทำลายตัวเพื่อให้ despawn
    pcall(function()
        if mob and mob.Parent and humanoid.Health <= 0 then
            for _, p in ipairs(mob:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                end
            end
        end
    end)
end

local function AttackOnce()
    local character = LP.Character
    local playerRoot = getRoot(character)
    if not playerRoot then return end

    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    local pos = playerRoot.Position
    local range = Settings.Range
    local dmg = Settings.Damage
    local hit = 0

    for _, enemy in ipairs(enemies:GetChildren()) do
        if hit >= Settings.MaxTargets then break end
        if enemy:IsA("Model") then
            local humanoid = enemy:FindFirstChildOfClass("Humanoid")
            local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")

            if humanoid and enemyRoot and humanoid.Health > 0 then
                local dist = (enemyRoot.Position - pos).Magnitude
                if dist <= range then
                    pcall(function()
                        humanoid:TakeDamage(dmg)
                    end)
                    -- เลือดเหลือน้อยกว่าดาเมจ / ใกล้ 0 → บังคับตาย 100%
                    if humanoid.Health <= dmg or humanoid.Health <= humanoid.MaxHealth * 0.05 then
                        ForceKill(humanoid, enemy)
                    end
                    hit = hit + 1
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if Settings.Enabled then
            pcall(AttackOnce)
            task.wait(Settings.Delay)
        else
            task.wait(0.2)
        end
    end
end)

